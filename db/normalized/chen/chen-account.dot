digraph chen {
    graph [rankdir=TB, fontname="Arial", fontsize=11, splines=true,
           nodesep=0.35, ranksep=0.55, label="Нотация Чена: пользователи, права доступа, файлы, блокировки", labelloc=t, fontcolor=black];
    node  [fontname="Arial", fontsize=10, color=black, fontcolor=black];
    edge  [fontname="Arial", fontsize=9, color=black, fontcolor=black, arrowhead=none];
    "account" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "role" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "permission" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "file" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "account_ban" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "имеет_роль" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "даёт_право" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "загрузил" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "аватар" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "заблокирован" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "выдал_блокировку" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "имеет_роль" -> "account" [label="N"];
    "имеет_роль" -> "role" [label="1"];
    "даёт_право" -> "role" [label="M"];
    "даёт_право" -> "permission" [label="N"];
    "загрузил" -> "account" [label="1"];
    "загрузил" -> "file" [label="N"];
    "аватар" -> "account" [label="N"];
    "аватар" -> "file" [label="1"];
    "заблокирован" -> "account" [label="1"];
    "заблокирован" -> "account_ban" [label="N"];
    "выдал_блокировку" -> "account" [label="1"];
    "выдал_блокировку" -> "account_ban" [label="N"];
    "a_id" [shape=ellipse, label=<<u>id</u>>, width=0.9, height=0.35, fontsize=9];
    "account" -> "a_id";
    "a_email" [shape=ellipse, label=<<u>email</u>>, width=0.9, height=0.35, fontsize=9];
    "account" -> "a_email";
    "a_user" [shape=ellipse, label=<<u>username</u>>, width=0.9, height=0.35, fontsize=9];
    "account" -> "a_user";
    "a_pwd" [shape=ellipse, label="password_hash", width=0.9, height=0.35, fontsize=9];
    "account" -> "a_pwd";
    "a_name" [shape=ellipse, label="first_name", width=0.9, height=0.35, fontsize=9];
    "account" -> "a_name";
    "a_bio" [shape=ellipse, label="bio", width=0.9, height=0.35, fontsize=9];
    "account" -> "a_bio";
    "a_priv" [shape=ellipse, label="is_private", width=0.9, height=0.35, fontsize=9];
    "account" -> "a_priv";
    "a_del" [shape=ellipse, label="deleted_at", width=0.9, height=0.35, fontsize=9];
    "account" -> "a_del";
    "r_id" [shape=ellipse, label=<<u>id</u>>, width=0.9, height=0.35, fontsize=9];
    "role" -> "r_id";
    "r_code" [shape=ellipse, label=<<u>code</u>>, width=0.9, height=0.35, fontsize=9];
    "role" -> "r_code";
    "r_title" [shape=ellipse, label=<<u>title</u>>, width=0.9, height=0.35, fontsize=9];
    "role" -> "r_title";
    "p_id" [shape=ellipse, label=<<u>id</u>>, width=0.9, height=0.35, fontsize=9];
    "permission" -> "p_id";
    "p_code" [shape=ellipse, label=<<u>code</u>>, width=0.9, height=0.35, fontsize=9];
    "permission" -> "p_code";
    "f_id" [shape=ellipse, label=<<u>id</u>>, width=0.9, height=0.35, fontsize=9];
    "file" -> "f_id";
    "f_key" [shape=ellipse, label=<<u>storage_key</u>>, width=0.9, height=0.35, fontsize=9];
    "file" -> "f_key";
    "f_url" [shape=ellipse, label=<<u>external_url</u>>, width=0.9, height=0.35, fontsize=9];
    "file" -> "f_url";
    "f_mime" [shape=ellipse, label="mime_type", width=0.9, height=0.35, fontsize=9];
    "file" -> "f_mime";
    "f_size" [shape=ellipse, label="size_bytes", width=0.9, height=0.35, fontsize=9];
    "file" -> "f_size";
    "b_id" [shape=ellipse, label=<<u>id</u>>, width=0.9, height=0.35, fontsize=9];
    "account_ban" -> "b_id";
    "b_period" [shape=ellipse, label="active_during", width=0.9, height=0.35, fontsize=9];
    "account_ban" -> "b_period";
    "b_reason" [shape=ellipse, label="reason", width=0.9, height=0.35, fontsize=9];
    "account_ban" -> "b_reason";
}
