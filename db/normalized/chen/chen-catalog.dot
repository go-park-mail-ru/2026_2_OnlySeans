digraph chen {
    graph [rankdir=TB, fontname="Arial", fontsize=11, splines=true,
           nodesep=0.35, ranksep=0.55, label="Нотация Чена: каталог, сезоны и серии (двойной контур -- слабая сущность)", labelloc=t, fontcolor=black];
    node  [fontname="Arial", fontsize=10, color=black, fontcolor=black];
    edge  [fontname="Arial", fontsize=9, color=black, fontcolor=black, arrowhead=none];
    "film" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "genre" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "country" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "file" [shape=box, peripheries=1, style=bold, width=1.4, height=0.45];
    "season" [shape=box, peripheries=2, style=bold, width=1.4, height=0.45];
    "episode" [shape=box, peripheries=2, style=bold, width=1.4, height=0.45];
    "жанр_фильма" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "страна_фильма" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "премьера" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "похожие" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "файлы_фильма" [shape=diamond, peripheries=1, width=1.5, height=0.8, fixedsize=false];
    "состоит_из_сезонов" [shape=diamond, peripheries=2, width=1.5, height=0.8, fixedsize=false];
    "состоит_из_серий" [shape=diamond, peripheries=2, width=1.5, height=0.8, fixedsize=false];
    "жанр_фильма" -> "film" [label="M"];
    "жанр_фильма" -> "genre" [label="N"];
    "страна_фильма" -> "film" [label="M"];
    "страна_фильма" -> "country" [label="N"];
    "премьера" -> "film" [label="M"];
    "премьера" -> "country" [label="N"];
    "похожие" -> "film" [label="M"];
    "похожие" -> "film" [label="N"];
    "файлы_фильма" -> "film" [label="M"];
    "файлы_фильма" -> "file" [label="N"];
    "состоит_из_сезонов" -> "film" [label="1"];
    "состоит_из_сезонов" -> "season" [label="N"];
    "состоит_из_серий" -> "season" [label="1"];
    "состоит_из_серий" -> "episode" [label="N"];
    "fm_id" [shape=ellipse, label=<<u>id</u>>, width=0.9, height=0.35, fontsize=9];
    "film" -> "fm_id";
    "fm_title" [shape=ellipse, label="title", width=0.9, height=0.35, fontsize=9];
    "film" -> "fm_title";
    "fm_type" [shape=ellipse, label="film_type", width=0.9, height=0.35, fontsize=9];
    "film" -> "fm_type";
    "fm_year" [shape=ellipse, label="production_year", width=0.9, height=0.35, fontsize=9];
    "film" -> "fm_year";
    "fm_dur" [shape=ellipse, label="duration_min", width=0.9, height=0.35, fontsize=9];
    "film" -> "fm_dur";
    "fm_age" [shape=ellipse, label="age_limit", width=0.9, height=0.35, fontsize=9];
    "film" -> "fm_age";
    "s_num" [shape=ellipse, label=<<u>season_number</u>>, width=0.9, height=0.35, fontsize=9];
    "season" -> "s_num";
    "s_title" [shape=ellipse, label="title", width=0.9, height=0.35, fontsize=9];
    "season" -> "s_title";
    "e_num" [shape=ellipse, label=<<u>episode_number</u>>, width=0.9, height=0.35, fontsize=9];
    "episode" -> "e_num";
    "e_title" [shape=ellipse, label="title", width=0.9, height=0.35, fontsize=9];
    "episode" -> "e_title";
    "e_dur" [shape=ellipse, label="duration_min", width=0.9, height=0.35, fontsize=9];
    "episode" -> "e_dur";
    "e_date" [shape=ellipse, label="release_date", width=0.9, height=0.35, fontsize=9];
    "episode" -> "e_date";
    "rel_type" [shape=ellipse, label="release_type", width=0.9, height=0.35, fontsize=9];
    "премьера" -> "rel_type";
    "rel_date" [shape=ellipse, label="release_date", width=0.9, height=0.35, fontsize=9];
    "премьера" -> "rel_date";
    "ff_role" [shape=ellipse, label="file_role", width=0.9, height=0.35, fontsize=9];
    "файлы_фильма" -> "ff_role";
    "ff_sort" [shape=ellipse, label="sort_order", width=0.9, height=0.35, fontsize=9];
    "файлы_фильма" -> "ff_sort";
    "g_name" [shape=ellipse, label=<<u>name</u>>, width=0.9, height=0.35, fontsize=9];
    "genre" -> "g_name";
    "c_iso" [shape=ellipse, label=<<u>iso_code</u>>, width=0.9, height=0.35, fontsize=9];
    "country" -> "c_iso";
}
