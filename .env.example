DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=onlyseans

RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
S3_PUBLIC_ENDPOINT=http://localhost:8050

# Shared only by the product backend and OnlineConf. Never expose it to a browser.
ONLINECONF_SERVICE_TOKEN=replace-with-a-long-random-secret
ONLINECONF_IMAGE=onlyseans_onlineconf
ONLINECONF_HOST_PORT=8081
ONLINECONF_REFRESH_INTERVAL=10s
ONLINECONF_HTTP_TIMEOUT=2s
